{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "strict": true,
        "jsx": "preserve",
        "sourceMap": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "lib": [
            "ESNext",
            "DOM"
        ],
        "types": [
            "vitest/globals",
            "chrome",
            "@types/chrome",
            "node"
        ],
 x                   \af        "allowJs": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "__tests__/**/*.ts",
        "*.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.js"
    ]
}